{
  "name": "connect-plus",
  "version": "1.0.0",
  "description": "ConnectPlus: Communication Without Barriers - AI-Powered Accessibility Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"tsx watch server/src/index.ts\" \"vite\"",
    "build": "vite build && tsc -p server/tsconfig.json",
    "build:client": "vite build",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "benchmark": "node server/benchmark.js"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "lru-cache": "^11.0.2",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "autocannon": "^8.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
