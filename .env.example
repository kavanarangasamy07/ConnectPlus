# ConnectPlus Environment Configuration Example

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Optional AI LLM Integration (fallback to fuzzy local FAQ if unset)
# LLM_API_KEY=your_gemini_or_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional Translation Provider Override (Default: MyMemory with zero setup)
# DEEPL_API_KEY=your_deepl_key_here
# GOOGLE_TRANSLATE_API_KEY=your_google_key_here

# Optional SMS / Dispatch Provider (Disabled by default; wa.me & sms: fallback used)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
